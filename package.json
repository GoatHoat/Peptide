{
  "name": "pepstack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ensure-config": "node scripts/ensure-config.mjs",
    "predev": "npm run ensure-config",
    "prebuild": "npm run ensure-config",
    "ios:prep": "npm install && npm run build && npx cap sync ios && node scripts/check-ios-build.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/share": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^11.15.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
